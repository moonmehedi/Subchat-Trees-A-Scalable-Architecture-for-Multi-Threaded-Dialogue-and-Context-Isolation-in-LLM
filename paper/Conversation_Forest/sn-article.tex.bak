\begin{document}

\title[Conversation Forests]{Conversation Forests: A Scalable Architecture for Multi-Threaded Dialogue and Context Isolation in Large Language Models}

\author*[1]{\fnm{Mehedi Hasan} \sur{Moon}}\email{the.mehedi.hasan.moon@gmail.com}

\author[1]{\fnm{Kabbo Sarker} \sur{Surjo}}\email{kabbosarker29@gmail.com}

\author[1]{\fnm{Md.} \sur{Akhtaruzzaman}}\email{akhter900@cse.mist.ac.bd}

\affil*[1]{\orgdiv{Department of Computer Science and Engineering}, \orgname{Military Institute of Science and Technology (MIST)}, \orgaddress{\city{Dhaka}, \country{Bangladesh}}}

\abstract{Large Language Models (LLMs) have transformed conversational AI, yet they face a critical challenge: context pollution in multi-topic conversations. When users discuss multiple subjects within a single conversation, information from different topics becomes mixed, leading to confused responses and degraded quality. This problem is worsened by the ``lost in the middle'' phenomenon, where models struggle to retrieve information from the middle of long contexts. We introduce \textit{Conversation Forests}, a hierarchical architecture that organizes dialogues into tree structures where each branch maintains isolated context for a specific topic. Users can create sub-conversations (subchats) from any message, with each branch having its own message buffer and optional retrieval-augmented generation (RAG) support. Our approach prevents context contamination by design rather than requiring post-hoc disentanglement. We evaluate our system using scenarios adapted from the ``Lost in the Middle'' methodology, testing context isolation when multiple coding problems are discussed with interleaved messages. Results show that Conversation Forests achieves 85-95\% accuracy in maintaining correct context, compared to 40-60\% for traditional linear conversations. The architecture also reduces effective context length per branch, keeping relevant information within the attention-favored positions of the model's context window.}

\keywords{Large Language Models \and Conversational AI \and Context Management \and Dialogue Systems \and Tree-Structured Conversations \and Memory Management}

%%\pacs[JEL Classification]{D8, H51}

