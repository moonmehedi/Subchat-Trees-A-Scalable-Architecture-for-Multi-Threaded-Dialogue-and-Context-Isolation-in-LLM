\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces RAG retrieval rate during the 43 recall probes. Probe retrieval is used as a memory-sufficiency signal because every probe asks the model to recover earlier topic content.}}{50}{figure.caption.28}\protected@file@percent }
\newlabel{fig:probe_rag_buffer_all}{{4.4}{50}{RAG retrieval rate during the 43 recall probes. Probe retrieval is used as a memory-sufficiency signal because every probe asks the model to recover earlier topic content}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Tokens per correct answer across model sizes and buffer sizes. The y-axis uses a log scale because the 7B baseline becomes extremely inefficient at larger buffers.}}{50}{figure.caption.29}\protected@file@percent }
